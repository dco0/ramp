{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "build",
		"rootDir": "src",
		"sourceMap": true
	},
	"include": ["src/**/*"],
	"exclude": []
}
